# GEMINI_API_KEY: Required for Gemini AI Pet Chatbot API calls.
# - Khi deploy lên Vercel: Thêm biến GEMINI_API_KEY vào Project Settings > Environment Variables
# - Khi deploy lên Netlify: Thêm biến GEMINI_API_KEY vào Site configuration > Environment variables
# - Trên máy cá nhân / dev: Điền trực tiếp API key vào file .env
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloudinary configuration for media uploads (images, audio, video)
VITE_CLOUDINARY_CLOUD_NAME="sq7gvzba"
VITE_CLOUDINARY_UPLOAD_PRESET="ml_default"

