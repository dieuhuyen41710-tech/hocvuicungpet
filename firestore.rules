rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if true;
    }
    match /students/{studentId} {
      allow read, write: if true;
    }
    match /settings/{docId} {
      allow read, write: if true;
    }
    match /subjects/{id} {
      allow read, write: if true;
    }
    match /mapNodes/{id} {
      allow read, write: if true;
    }
    match /lessons/{id} {
      allow read, write: if true;
    }
    match /tests/{id} {
      allow read, write: if true;
    }
    match /pets/{id} {
      allow read, write: if true;
    }
    match /miniGames/{id} {
      allow read, write: if true;
    }
    match /spaces3D/{id} {
      allow read, write: if true;
    }
    match /statistics/{id} {
      allow read, write: if true;
    }
    match /ratings/{id} {
      allow read, write: if true;
    }
    match /messages/{id} {
      allow read, write: if true;
    }
    match /studentTasks/{id} {
      allow read, write: if true;
    }
  }
}
